{
  "name": "lupa",
  "productName": "Lupa",
  "version": "0.10.1",
  "description": "Lupa para LoL Idle: o jogo com as duas contas e o painel da Lupa numa janela só. Lê a tela; só clica no jogo quando você pede (Entregar e seguir, Alt+L). Mostra onde gastar o ouro simulando no motor do jogo.",
  "main": "main.js",
  "private": true,
  "author": "Iguinhowill",
  "license": "UNLICENSED",
  "scripts": {
    "preparar": "node copiar-lupa.mjs",
    "start": "node copiar-lupa.mjs && electron .",
    "dist": "node copiar-lupa.mjs && electron-builder --win --publish never",
    "test": "node copiar-lupa.mjs && node --test regras.test.js armazem.test.js layout.test.js alertas.test.js acoes.test.js gastar.test.js",
    "teste:gastar": "node copiar-lupa.mjs && electron teste-gastar/rodar.js",
    "teste:gastar-app": "node copiar-lupa.mjs && electron teste-gastar/app.js",
    "teste:acao": "node copiar-lupa.mjs && electron teste-acao/rodar.js"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.iguinhowill.lupa",
    "productName": "Lupa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "armazem.js",
      "regras.js",
      "layout.js",
      "alertas.js",
      "atalhos.js",
      "acoes.js",
      "gastar.js",
      "simulador.js",
      "sim/**",
      "preload-*.js",
      "casca.html",
      "casca.css",
      "casca.js",
      "gerado/**",
      "lupa/**",
      "icone.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icone.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Lupa-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Iguinhowill",
        "repo": "lupa"
      }
    ]
  }
}
