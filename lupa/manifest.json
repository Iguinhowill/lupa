{
  "manifest_version": 3,
  "name": "Lupa para LoL Idle",
  "version": "0.10.0",
  "description": "Painel de qualidade de vida para o LoL Idle. Só lê a tela: não clica e não joga. Se você entrar no Lupa Online, envia a leitura só para o seu banco.",
  "permissions": ["storage", "sidePanel", "notifications", "power", "alarms"],
  "host_permissions": ["https://ledowohvumzufzvvtnji.supabase.co/*"],
  "incognito": "spanning",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://lolidle.com/*", "https://www.lolidle.com/*"],
      "js": ["content.js"],
      "css": ["tema.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "painel.html" },
  "action": {
    "default_title": "Abrir a Lupa",
    "default_icon": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png" }
  },
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" }
}
